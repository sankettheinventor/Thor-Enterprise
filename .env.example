# THOR Enterprise — example config. Copy to `.env` and adjust. NEVER commit real secrets (P14.1).

# --- Wall (Module 1) ---
THOR_ROOM_IMAGE=thor-room:dev          # OCI image tag built from wall/image/Dockerfile
THOR_DEFAULT_CPU=1.0                    # nano-cpus = CPU * 1e9
THOR_DEFAULT_MEM=1g                     # mem_limit (Docker syntax)
THOR_DEFAULT_DISK=2g                    # ephemeral storage cap (best-effort on day one)

# Per-room ports (namespaced per container — see System Design §3.3)
THOR_AGENT_PORT=8000                   # inbound: ThorManager -> agent-server
THOR_LEASH_PORT=8001                   # the ONLY outbound route (arrives with Module 2 / Leash)

# --- Identity (Ed25519 local signer stub — Module 1 / Identity Stamper 1.6) ---
# Path to the control-plane signing key. Auto-generated on first run if missing.
THOR_SIGNING_KEY=.thor/room_signing_key.pem

# --- TLS / mobile push — Web Push REQUIRES HTTPS. Caddy fronts the plane (see Caddyfile + RUNBOOK) ---
THOR_SITE_ADDRESS=localhost              # a domain (cockpit.yourco.com) → auto Let's Encrypt;
                                        # an IP (https://192.168.1.50) or localhost → Caddy internal CA
THOR_VAPID_CONTACT=mailto:ops@thor.local # contact in the VAPID JWT (a real mailto: in production)

# --- Git host (P5) — local-git by default; set THOR_GIT_BACKEND=gitea for a live Gitea server ---
THOR_GIT_BACKEND=local                  # local | gitea  (gitea = real branches/PRs/merges via API)
GITEA_URL=http://localhost:3000         # the Gitea server (compose service name: http://gitea:3000)
GITEA_OWNER=thor                        # the Gitea org/user that owns the repos
GITEA_TOKEN=                            # API token (mint in Gitea; NEVER commit it) — required when backend=gitea

# --- Adapters (AGT representative; real Microsoft AGT plugs in behind the same adapter at deploy) ---
AGT_ADAPTER_URL=http://localhost:7160   # stub: always-allow + log on day one (no Azure creds in dev)
