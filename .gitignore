# Python
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/

# Env / secrets (never commit real secrets — P14.1)
.env
*.key
*.pem
# Frontier-model credentials — NEVER commit the user's Claude/OpenAI/etc. login (it lives in ~/.thor,
