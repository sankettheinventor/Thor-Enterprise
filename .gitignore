.claude/
**/.credentials.json
*.credentials.json
claude_token
consent.json
*.oauth.json

# Read-only study material — present in the tree but NEVER committed or imported (Rule 10).
_reference/
docs/thor2 - Copy/

# Identity signing key + smoke-test scratch (local, never committed)
.thor/
.smoke/

# OS / editor
.DS_Store
Thumbs.db
